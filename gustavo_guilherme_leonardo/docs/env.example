# SentinelTrade - modelo de variáveis de ambiente
# NUNCA versionar o .env nem colocar valores reais aqui.

# ===== Aplicação =====
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=https://localhost:8080

# ===== Banco de dados =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentineltrade
DB_USER=changeme
DB_PASSWORD=changeme

# ===== Segurança =====
# Segredo para assinar sessões/tokens (gerar valor aleatório longo)
JWT_SECRET=changeme
SESSION_TTL_MINUTES=30
# Custo do hash de senha/PIN (ex.: bcrypt cost)
PASSWORD_HASH_COST=12

# ===== MFA (RNF-02, RN-12) =====
MFA_CODE_LENGTH=6
MFA_CODE_TTL_MINUTES=5
MFA_MAX_ATTEMPTS=3
ACCOUNT_LOCK_MINUTES=15

# ===== Serviço de cotações (externo) =====
QUOTES_API_URL=
QUOTES_API_KEY=changeme
QUOTES_TIMEOUT_SECONDS=3
QUOTE_MAX_AGE_SECONDS=10

# ===== Corretora / sandbox (externo) =====
BROKER_API_URL=
BROKER_API_KEY=changeme
BROKER_TIMEOUT_SECONDS=5

# ===== Retentativas (RNF-09) =====
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE_SECONDS=1

# ===== Fila de mensagens =====
QUEUE_URL=
QUEUE_USER=changeme
QUEUE_PASSWORD=changeme

# ===== Serviço de e-mail (MFA e notificações) =====
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=changeme
EMAIL_PASSWORD=changeme
EMAIL_FROM=no-reply@example.com

# ===== Regras de negócio configuráveis (RN-05, RN-06) =====
MAX_ORDER_VALUE=50000
MAX_DAILY_EXPOSURE=200000
TRADING_START=10:00
TRADING_END=17:55
TRADING_TIMEZONE=America/Sao_Paulo

# ===== Auditoria (RNF-07) =====
AUDIT_RETENTION_YEARS=5
