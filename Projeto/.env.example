# SentinelTrade - configuração local. Copie para .env e ajuste.
# APP_ENV=development exibe o código MFA na resposta (debug_code). Fora de development,
# a aplicação se recusa a iniciar com SECRET_KEY de exemplo ou com menos de 32 caracteres.
APP_ENV=development
DATABASE_URL=sqlite:///./sentineltrade.db
# Gere uma chave longa e aleatória antes de qualquer exposição de rede:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-secret
# Para PostgreSQL, exemplo:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/sentineltrade
